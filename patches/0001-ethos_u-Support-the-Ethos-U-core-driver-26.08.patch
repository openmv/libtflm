Subject: [PATCH] ethos_u: Support the Ethos-U core driver 26.08.

The 26.08 driver replaced ethosu_device_u55_u65.c and ethosu_device_u85.c
with a backend and a PMU source per variant, requires ETHOSU_MACS for a
single variant build, and supports all variants in one build
(ETHOSU_MULTI_VARIANT), where the variant is selected at runtime from the
command stream's optimizer config.

Build the 26.08 sources, add ETHOSU_ARCH=multi for a multi variant build,
and require ETHOSU_MACS for single variant builds.
---
--- a/tensorflow/lite/micro/tools/make/ext_libs/ethos_u.inc
+++ b/tensorflow/lite/micro/tools/make/ext_libs/ethos_u.inc
@@ -40,12 +40,16 @@
 ifeq (,$(ETHOSU_DRIVER_LIBS))
     THIRD_PARTY_CC_SRCS += $(ETHOSU_DRIVER_PATH)/src/ethosu_pmu.c \
                            $(ETHOSU_DRIVER_PATH)/src/ethosu_driver.c
-    # Add the Ethos-U device-specific driver source.
-    ifeq ($(ETHOSU_ARCH), u85)
-      THIRD_PARTY_CC_SRCS += $(ETHOSU_DRIVER_PATH)/src/ethosu_device_u85.c
+    # Add the Ethos-U variant-specific driver sources, for all variants in
+    # multi variant mode.
+    ifeq ($(ETHOSU_ARCH), multi)
+      ETHOSU_DRIVER_VARIANTS := u55 u65 u85
     else
-      THIRD_PARTY_CC_SRCS += $(ETHOSU_DRIVER_PATH)/src/ethosu_device_u55_u65.c
+      ETHOSU_DRIVER_VARIANTS := $(ETHOSU_ARCH)
     endif
+    THIRD_PARTY_CC_SRCS += $(foreach v,$(ETHOSU_DRIVER_VARIANTS), \
+                             $(ETHOSU_DRIVER_PATH)/src/ethosu_backend_$(v).c \
+                             $(ETHOSU_DRIVER_PATH)/src/ethosu_pmu_$(v).c)
 else
     MICROLITE_LIBS += $(ETHOSU_DRIVER_LIBS)
 endif
@@ -65,9 +69,18 @@
 INCLUDES += -I$(ETHOSU_DRIVER_PATH)/include \
             -I$(CMSIS_PATH)/CMSIS/Core/Include
 
-ETHOSU_FLAGS := -DETHOSU_LOG_SEVERITY=ETHOSU_LOG_WARN
-ifeq ($(ETHOSU_ARCH), u55)
+ETHOSU_FLAGS := -DETHOSU -DETHOSU_LOG_SEVERITY=ETHOSU_LOG_WARN
+ifneq ($(ETHOSU_ARCH), multi)
+  ifeq (,$(ETHOSU_MACS))
+    $(error "ETHOSU_MACS must be set for ETHOSU_ARCH=$(ETHOSU_ARCH)")
+  endif
+  ETHOSU_FLAGS += -DETHOSU_MACS=$(ETHOSU_MACS)
+endif
+ifeq ($(ETHOSU_ARCH), multi)
   ETHOSU_FLAGS += \
+    -DETHOSU_MULTI_VARIANT
+else ifeq ($(ETHOSU_ARCH), u55)
+  ETHOSU_FLAGS += \
     -DETHOSU_ARCH=u55 \
     -DETHOSU55
 else ifeq ($(ETHOSU_ARCH), u65)
